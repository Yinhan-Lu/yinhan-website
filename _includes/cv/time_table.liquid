<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in entry.contents %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-auto cv-logo-col">
          {% if content.logo %}
            <div class="cv-logo-tile">
              <img
                class="cv-logo"
                src="{{ content.logo | prepend: '/assets/img/' | relative_url }}"
                alt="{{ content.institution | default: content.title }}"
              />
            </div>
          {% endif %}
        </div>
        <div class="col mt-2 mt-md-0 cv-main-col">
          {% comment %}
            Two shapes of entry. With `roles`, one institution heads the block and
            each role keeps its own dates, advisor and bullets — used where the
            same institution covers several positions. Without it, the entry is a
            single position and the title leads.
          {% endcomment %}
          {% if content.roles %}
            {% if content.institution %}
              <div class="cv-institution cv-block-institution">{{ content.institution }}</div>
            {% endif %}
            {% if content.location %}
              <div class="cv-location">{{ content.location }}</div>
            {% endif %}
            {% for role in content.roles %}
              <div class="cv-role">
                <div class="cv-head">
                  {% if role.title %}
                    <h6 class="cv-title font-weight-bold">{{ role.title }}</h6>
                  {% endif %}
                  {% if role.year %}
                    <span class="cv-date">{{ role.year }}</span>
                  {% endif %}
                </div>
                {% if role.affiliation %}
                  <div class="cv-affiliation">{{ role.affiliation }}</div>
                {% endif %}
                {% if role.advisor %}
                  <div class="cv-advisor">{{ role.advisor }}</div>
                {% endif %}
                {% if role.description %}
                  {% include cv/items.liquid list=role.description %}
                {% endif %}
              </div>
            {% endfor %}
          {% else %}
            <div class="cv-head">
              {% if content.title %}
                <h6 class="cv-title font-weight-bold">{{ content.title }}</h6>
              {% endif %}
              {% if content.year %}
                <span class="cv-date">{{ content.year }}</span>
              {% endif %}
            </div>
            {% if content.institution %}
              <div class="cv-institution">{{ content.institution }}</div>
            {% endif %}
            {% if content.location %}
              <div class="cv-location">{{ content.location }}</div>
            {% endif %}
            {% if content.advisor %}
              <div class="cv-advisor">{{ content.advisor }}</div>
            {% endif %}
            {% if content.department %}
              <div class="cv-department">{{ content.department }}</div>
            {% endif %}
            {% if content.maindescription %}
              <div>{{ content.maindescription }}</div>
            {% endif %}
            {% if content.description %}
              {% include cv/items.liquid list=content.description %}
            {% endif %}
          {% endif %}
          {% if content.items %}
            {% include cv/items.liquid list=content.items %}
          {% endif %}
          {% if content.linkitems %}
            <div class="container-links">
              {% for item in content.linkitems %}
                {% if item.link %}
                  <div class="container-link-button">
                    {% if item.linkname %}
                      <a href="{{ item.link }}" target="_blank" class="btncv z-depth-0">{{ item.linkname }}</a>
                    {% else %}
                      <a href="{{ item.link }}" target="_blank" class="btncv z-depth-0">doc</a>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
